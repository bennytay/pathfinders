{
  "name": "innercircle",
  "version": "0.1.0",
  "private": false,
  "description": "A local-first, privacy-first context layer for a small circle of close friends.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
