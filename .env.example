# InnerCircle runs fully in fixture mode without environment variables or network access.
#
# Optional public event search. This is a public JSON-feed URL, not a secret. Leave
# unset to keep the complete manual/offline planning flow and avoid any event request.
# NEXT_PUBLIC_EVENTS_FEED_URL=https://public.example/events
#
# Remote adapters are deliberately not enabled. A future adapter must use explicit
# per-note consent and document every variable it requires here.
#
# Copy this file to .env.local only when developing an approved optional adapter.
